# Copy to /etc/bind-cache-analyze/ns-monitor.env, set owner root:bindcache and mode 0640.
# URL-encode DSN credentials: @ becomes %40.
CLICKHOUSE_DSN=clickhouse://default:URL_ENCODED_PASSWORD@127.0.0.1:19000/bind_cache_analyze
NS_RELAY_TOKEN=replace-with-random-token
NS_WEB_OBSERVER_PASSWORD=replace-with-strong-random-password
NS_WEB_OPERATOR_PASSWORD=replace-with-another-strong-random-password
NS_WEB_ADMIN_PASSWORD=replace-with-a-third-strong-random-password
